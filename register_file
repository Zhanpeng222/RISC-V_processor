`timescale 1ns / 1ps

module register_file(
input logic clk,
input logic write,
input logic [1:0]addr1, //4
input logic [1:0]addr2, //4
input logic [1:0]writeAddr, //4
input logic [7:0]writeData, //31
output logic [7:0]read1, //31
output logic [7:0]read2 //31
    );
    
logic [7:0] regfile [3:0]; //31
    
integer i; 
initial 
    begin
        for(i = 0; i < 4; i++) //32 
        begin
            regfile[i] = 8'b0;
        end
    end

assign read1 = regfile[addr1];
assign read2 = regfile[addr2];

always_ff@(posedge clk)begin
    if(write)
        regfile[writeAddr] <= writeData;    
end

endmodule
