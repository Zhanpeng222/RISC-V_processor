`timescale 1ns / 1ps

module register_file(
    input logic clk,
    input logic [4:0]addr1,
    input logic [4:0]addr2,
    input logic [4:0]writeAddr,
    input logic [31:0]writeData,
    input logic write,
    output logic [31:0]read1,
    output logic [31:0]read2
    );
    
    logic [31:0]regfile[31:0];
    integer i;
    initial begin
        for(i = 0; i < 32; i++)begin
            regfile[i] = 32'b0;
        end
    end
    
    always_ff@(posedge clk)begin
        if(addr1 == 0) read1 <= 0;
        else if(write && (writeAddr == addr1)) read1 <= writeData;
        else read1 <= regfile[addr1];
        
        if(addr2 == 0) read2 <= 0;
        else if(write && (writeAddr == addr2)) read2 <= writeData;
        else read2 <= regfile[addr2];
        
        if(write && (writeAddr != 0))begin
            regfile[writeAddr] <= writeData;
        end
        
    end
    
    
endmodule
