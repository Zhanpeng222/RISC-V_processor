`timescale 1ns / 1ps

module datapath(
    input logic clk,
    input logic rst,
    input logic [31:0]instruction,
    input logic PCSrc,
    input logic ALUSrc,
    input logic RegWrite,
    input logic MemtoReg,
    input logic [3:0]ALUCtrl,
    input logic loadPC,
    output logic [31:0]PC,
    output logic zero,
    output logic [31:0]dAddress,
    output logic [31:0]dWriteData,
    input logic [31:0]dReadData,
    output logic [31:0]WriteBackData
    );
    
    PARAMETER INITIAL_PC = 32'h0040_0000;
    
    logic [6:0]opcode;
    assign opcode = instruction[6:0];
    
    logic [31:0] immI;
    logic [31:0] immS;
    logic [31:0] immSBranch;
    
    assign immI = {{20{instruction[31]}},instruction[31:20]};
    assign immS = {{20{instruction[31]}},instruction[31:25],instruction[11:7]};
    assign SBranch = {{19{instruction[31]}},instruction[31],instruction[7],instruction[30:25],instruction[11:8],1'b0};
        
    logic [4:0]rs1;
    logic [4:0]rs2;
    logic [4:0]rd;
    assign rs1 = instruction[19:15];
    assign rs2 = instruction[24:20];
    assign rd = instruction[11:7];
    
    logic [31:0] readReg1;
    logic [31:0] readReg2;
    
    register_file register_file_instance(
    .clk(clk),
    .addr1(rs1),
    .addr2(rs2),
    .writeAddr(rd),
    .writeData(WriteBackData),
    .write(RegWrite),
    .read1(readReg1),
    .read2(readReg2)
    );
    
    logic [31:0]selectedImmediate;
    always_comb begin
        if(opcode == 7'b0100011)
            selectedImmediate = immS; 
        else
            selectedImmediate = immI;
    end
    
    logic [31:0]alu_input_2;
    always_comb begin
        if(ALUSrc == 1'b0)
            alu_input_2 = readReg2;
        else
            alu_input_2 = selectedImmediate;
    end
    
    logic [31:0] alu_result;
    
    alu alu_unit(
        .alu_operation(ALUCtrl),
        .operand1(readReg1),
        .operand2(alu_input_2),
        .result(alu_result),
        .zero(zero)
    );
    
    assign dWriteData = readReg2;
    
    assign dAddress = alu_result; 
    
    always_comb begin
        if(MemtoReg == 1'b1)
            WriteBackData = dReadData;
        else
            WriteBackData = alu_result;
    end
    
    logic [31:0]PC_plus_4;
    logic [31:0]next_PC;
    logic [31:0]branch_target;
    assign PC_plus_4 = PC + 32'd4;
    
    always_comb begin
        if(PCSrc == 1'b1)
            next_PC = branch_target;
         else
            next_PC = PC_plus_4;
    end
    
    always_ff@(posedge clk)begin
        if(rst)
            PC <= INITIAL_PC;
        else if(loadPC)
            PC <= next_PC;
    end
endmodule
