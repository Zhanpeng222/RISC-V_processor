`timescale 1ns / 1ps

//main ALU block
module alu(alu_operation, operand1, operand2, result, zero);
input[3:0] alu_operation;
input[31:0] operand1, operand2;
output reg [31:0] result;
output zero;

localparam logic [3:0] ALU_ADD = 4'b0000;
localparam logic [3:0] ALU_SUB = 4'b0001;
localparam logic [3:0] ALU_AND = 4'b0010;
localparam logic [3:0] ALU_OR = 4'b0011;
localparam logic [3:0] ALU_XOR = 4'b0100;
localparam logic [3:0] ALU_SLT = 4'b0101;
localparam logic [3:0] ALU_SLL = 4'b0111;
localparam logic [3:0] ALU_SRL = 4'b1000;
localparam logic [3:0] ALU_SRA = 4'b10001;
//this alu block utilizes built in xilinx math functions
always_comb
begin
    case(alu_operation)
        ALU_ADD: result = operand1 + operand2; //Add
        ALU_SUB: result = operand1 - operand2; //Sub
        ALU_AND: result = operand1 & operand2; //And
        ALU_OR: result = operand1 | operand2; //Or
        ALU_XOR: result = operand1 ^ operand2; //Xor
        ALU_SLT: result = $signed(operand1) < $signed(operand2); //Signed less than or SLT
        ALU_SLL: result = operand1 << operand2[4:0];//logical shift left or SLL
        ALU_SRL: result = operand1 >> operand2[4:0];//logical shift right or SRL
        ALU_SRA: result = $signed(operand1) >>> operand2[4:0];//arithmetic shift right or SRA
        default: result = 32'd0;
    endcase
end

assign zero = (result == 32'd0);

endmodule
