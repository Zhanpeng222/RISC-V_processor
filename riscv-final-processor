`timescale 1ns / 1ps

module riscv_final#(
    parameter logic [31:0] INITIAL_PC = 32'h0000_3000
    )(
    input logic clk,
    input logic rst,
    output logic [31:0]PC,
    output logic iMemRead,
    input logic [31:0]instruction,
    output logic [31:0]ALUResult,
    output logic [31:0]dAddress,
    output logic [31:0]dWriteData,
    input logic [31:0]dReadData,
    output logic MemRead,
    output logic MemWrite,
    output logic [31:0]WriteBackData
    );
    
    localparam logic [3:0]ALU_ADD = 4'b0000;
    localparam logic [3:0]ALU_SUB = 4'b0001;
    
    logic id_Branch;
    logic id_MemRead;
    logic id_MemWrite;
    logic id_RegWrite;
    logic id_MemtoReg;
    logic id_ALUSrc;
    logic [3:0]id_ALUCtrl;
    logic [2:0]id_branch_type;
    logic id_jump;
    logic id_jalr;
    
    logic ex_Branch;
    logic ex_MemRead;
    logic ex_MemWrite;
    logic ex_RegWrite;
    logic ex_MemtoReg;
    logic ex_ALUSrc;
    logic [3:0]ex_ALUCtrl;
    logic [4:0]ex_rd;
    logic [31:0]ex_alu_result;
    logic ex_zero;
    logic [2:0]ex_branch_type;
    logic ex_less_than;
    logic [31:0]ex_branch_target;
    logic ex_jump;
    logic ex_jalr;
    
    logic mem_Branch;
    logic mem_MemRead;
    logic mem_MemWrite;
    logic mem_RegWrite;
    logic mem_MemtoReg;
    logic [4:0]mem_rd;
    logic [31:0]mem_alu_result;
    logic mem_zero;
    logic [31:0]mem_branch_target;
    logic [31:0]mem_write_data;
    logic [2:0]mem_branch_type;
    logic mem_less_than;
    logic mem_jump;
    
    logic wb_RegWrite;
    logic wb_MemtoReg;
    logic [4:0]wb_rd;
    logic [31:0]wb_alu_result;
    logic wb_flush;

    logic [31:0]if_PC;
    logic [31:0]id_PC;
    logic [31:0]PC_plus_4;
    logic [31:0]next_PC;
    logic mem_PCSrc;
    
    logic [31:0]ex_PC;
    logic [31:0]immEX;
    logic [31:0]ex_imm_branch;
    logic [31:0]ex_PC_plus_4;
    logic [31:0]ex_result_to_mem;
    
    logic hazard;
    
    //Program counter 
    assign PC = if_PC;
    assign PC_plus_4 = if_PC + 32'd4;
    always_comb begin
        if(mem_PCSrc) next_PC = mem_branch_target;
        else next_PC = PC_plus_4;
    end
    
    assign ex_PC_plus_4 = ex_PC + 4;
    always_comb begin
        if(ex_jump) ex_result_to_mem = ex_PC_plus_4;
        else ex_result_to_mem = ex_alu_result;
    end
    
    always_comb begin
        mem_PCSrc = 0;
        if(mem_jump) mem_PCSrc = 1'b1;
        else if(mem_Branch)
            case(mem_branch_type)
                3'b000: mem_PCSrc = mem_zero; //BEQ
                3'b001: mem_PCSrc = !mem_zero; //BNE
                3'b100: mem_PCSrc = mem_less_than; //BLT
                3'b101: mem_PCSrc = !mem_less_than; //BGE
                default: mem_PCSrc = 0;
            endcase
    end
    
    //Logic to assigning reg1 and reg2 along with forwarding
    logic [31:0]readReg1;
    logic [31:0]readReg2;
    logic [31:0]ex_readReg1;
    logic [31:0]ex_readReg2;
    logic [1:0]ForwardA;
    logic [1:0]ForwardB;
    
    //logic to immediate instruction
    logic [4:0]id_rs1;
    logic [4:0]id_rs2;
    logic [4:0]rd;
    logic [4:0]ex_rs1;
    logic [4:0]ex_rs2;
    
    logic id_uses_rs1;
    logic id_uses_rs2;
    
    logic [31:0]immI;
    logic [31:0]immS;
    logic [31:0]immSBranch;
    logic [31:0]immU;
    logic [31:0]immJ;
    
    assign immI = {{20{instruction[31]}},instruction[31:20]};
    assign immS = {{20{instruction[31]}},instruction[31:25],instruction[11:7]};
    assign immSBranch = {{19{instruction[31]}},instruction[31],instruction[7],instruction[30:25],instruction[11:8],1'b0};
    assign immU = {instruction[31:12],12'b0};
    assign immJ = {{12{instruction[31]}},{instruction[19:12]},instruction[20],{instruction[30:21]},1'b0};
    
    //select immediate
    //S-type store, I-type use immediate, U-type load upper immediate, J-type Jump branches
    logic [6:0]opcode;
    assign opcode = instruction[6:0];
    logic [31:0]selectedImmediate;
    always_comb begin
        if(opcode == 7'b0100011) selectedImmediate = immS;
        else if(opcode == 7'b0110111) selectedImmediate = immU;
        else if(opcode == 7'b1100011) selectedImmediate = immSBranch;
        else if(opcode == 7'b1101111) selectedImmediate = immJ;
        else selectedImmediate = immI;
    end
    
    //Assigning register destination for rs1, rs2, and rd
    assign id_rs1 = opcode == 7'b0110111 ? 0 : instruction[19:15];
    assign id_rs2 = instruction[24:20];
    assign rd = instruction[11:7];
    
    //Assigning forwarding statement for both input 1 and input 2
    always_comb begin
        if((mem_RegWrite == 1) && (mem_rd != 0) && (mem_rd == ex_rs1)) ForwardA = 2'b10;
        else if((wb_RegWrite == 1) && (wb_rd != 0) && (wb_rd == ex_rs1)) ForwardA = 2'b01;
        else ForwardA = 2'b00;
        
        if((mem_RegWrite == 1) && (mem_rd != 0) && (mem_rd == ex_rs2)) ForwardB = 2'b10;
        else if((wb_RegWrite == 1) && (wb_rd != 0) && (wb_rd == ex_rs2)) ForwardB = 2'b01;
        else ForwardB = 2'b00;
    end
    
    //Assigning the actual forwarded values
    logic [31:0]forwarded_a;
    logic [31:0]forwarded_b;
    always_comb begin
        case(ForwardA)
            2'b00: forwarded_a = ex_readReg1;
            2'b01: forwarded_a = WriteBackData;
            2'b10: forwarded_a = mem_alu_result;
            default: forwarded_a = ex_readReg1;
        endcase
        case(ForwardB)
            2'b00: forwarded_b = ex_readReg2;
            2'b01: forwarded_b = WriteBackData;
            2'b10: forwarded_b = mem_alu_result;
            default: forwarded_b = ex_readReg2;
        endcase
        if($signed(forwarded_a) < $signed(forwarded_b))ex_less_than = 1;
        else ex_less_than = 0;
    end
    
    
    //ALU operand either input 2 or select immdiate
    //Updated to forward_b for hazard
    logic [31:0]ex_alu_input_2;
    always_comb begin
        if(ex_ALUSrc == 1'b0)
            ex_alu_input_2 = forwarded_b;
        else
            ex_alu_input_2 = immEX;
    end
    
    assign ALUResult = ex_alu_result;
    
    alu alu_unit(
        .alu_operation(ex_ALUCtrl),
        .operand1(forwarded_a),
        .operand2(ex_alu_input_2),
        .result(ex_alu_result),
        .zero(ex_zero)
    );
    
    //Calculate branch target address
    always_comb begin
        if(ex_jalr)begin
            ex_branch_target = forwarded_a + ex_imm_branch;
            ex_branch_target[0] = 0;
        end
        else ex_branch_target = ex_PC + ex_imm_branch;
    end
    
    register_file register_file_instance(
    .clk(clk),
    .addr1(id_rs1),
    .addr2(id_rs2),
    .writeAddr(wb_rd),
    .writeData(WriteBackData),
    .write(wb_RegWrite),
    .read1(ex_readReg1),
    .read2(ex_readReg2)
    );
    
    always_comb begin 
        if(ex_MemRead && (ex_rd != 0) && (id_uses_rs1 && ((ex_rd == id_rs1)) || (id_uses_rs2 &&(ex_rd == id_rs2)))) hazard = 1;
        else hazard = 0;
    end
    
    always_comb begin
        if(hazard && !mem_PCSrc) iMemRead = 0;
        else iMemRead = 1;
    end
    
    //Refere to RISC-V website for opcode
    //Control decoder
    always_comb begin
        id_ALUCtrl = ALU_ADD;
        id_Branch = 1'b0;
        id_MemRead = 1'b0;
        id_MemWrite = 1'b0;
        id_RegWrite = 1'b0;
        id_ALUSrc = 1'b0;
        id_MemtoReg = 1'b0;
        id_branch_type = instruction[14:12];
        id_jump = 1'b0;
        id_jalr = 1'b0;
        id_uses_rs1 = 1'b0;
        id_uses_rs2 = 1'b0;
        case(opcode)
            7'b0110011: 
                begin
                    id_ALUSrc = 1'b0; //Register ALU(same as R type instruction)
                    id_MemtoReg = 1'b0;
                    id_RegWrite = 1'b1;
                    id_uses_rs1 = 1'b1;
                    id_uses_rs2 = 1'b1;
                    case(instruction[14:12])
                        3'b000:
                            begin
                                if(instruction[30] == 1'b1) id_ALUCtrl = ALU_SUB; //ALU subtract
                                else id_ALUCtrl = ALU_ADD; //ALU add
                            end
                        3'b001: id_ALUCtrl = 4'b0111; //SLL
                        3'b010: id_ALUCtrl = 4'b0101; //SLT
                        3'b100: id_ALUCtrl = 4'b0100; //XOR
                        3'b101: 
                            begin
                                if(instruction[30] == 1'b1) id_ALUCtrl = 4'b1001; //SRA
                                else id_ALUCtrl = 4'b1000; //SRL
                            end
                        3'b110: id_ALUCtrl = 4'b0011; //Or
                        3'b111: id_ALUCtrl = 4'b0010; //And
                        default: id_ALUCtrl = ALU_ADD;
                    endcase
                end
            7'b0010011: 
                begin
                    id_ALUSrc = 1'b1; //Immediate ALU
                    id_MemtoReg = 1'b0;
                    id_RegWrite = 1'b1;
                    id_uses_rs1 = 1'b1;
                    id_uses_rs2 = 1'b0;
                    //The bottom ALUCtrl determine the immediaate add, etc.
                    case(instruction[14:12])
                        3'b000: id_ALUCtrl = ALU_ADD;
                        3'b001: id_ALUCtrl = 4'b0111;
                        3'b010: id_ALUCtrl = 4'b0101;
                        3'b100: id_ALUCtrl = 4'b0100;
                        3'b101:
                            begin
                                if(instruction[30] == 1'b1) id_ALUCtrl = 4'b1001;
                                else id_ALUCtrl = 4'b1000;
                            end
                        3'b110: id_ALUCtrl = 4'b0011;
                        3'b111: id_ALUCtrl = 4'b0010;
                        default: id_ALUCtrl = ALU_ADD;
                    endcase
                end
            7'b0110111:
                begin
                    id_ALUSrc = 1'b1; //BEQ or BNE case statement (LUI)
                    id_ALUCtrl = ALU_ADD;
                    id_RegWrite = 1'b1;
                    id_MemtoReg = 1'b0;
                end
            7'b1101111: 
                begin
                    id_jump = 1'b1; //Jump instruction JAL
                    id_RegWrite = 1'b1;
                    id_MemWrite = 1'b0;
                    id_MemRead = 1'b0;
                    id_Branch = 1'b0;
                    id_MemtoReg = 1'b0;
                end
            7'b1100111:
                begin //JALR
                    if(instruction[14:12] == 3'b000)begin
                        id_jump = 1'b1;
                        id_jalr = 1'b1;
                        id_RegWrite = 1'b1;
                        id_MemtoReg = 1'b0;
                        id_Branch = 1'b0;
                        id_MemRead = 1'b0;
                        id_MemWrite = 1'b0;
                        id_uses_rs1 = 1'b1;
                        id_uses_rs2 = 1'b0;
                    end
                end
            7'b0000011: 
                begin 
                    id_ALUSrc = 1'b1; //load 
                    id_MemtoReg = 1'b1;
                    id_ALUCtrl = ALU_ADD;
                    id_MemRead = 1'b1;
                    id_MemWrite = 1'b0;
                    id_RegWrite = 1'b1;
                    id_uses_rs1 = 1'b1;
                    id_uses_rs2 = 1'b0;
                end 
            7'b0100011:
                begin
                    id_ALUSrc = 1'b1; //store
                    id_MemtoReg = 1'b0;
                    id_ALUCtrl = ALU_ADD;
                    id_MemWrite = 1'b1;
                    id_uses_rs1 = 1'b1;
                    id_uses_rs2 = 1'b1;
                end
            7'b1100011: 
                begin
                    id_ALUSrc = 1'b0; //conditional branch
                    id_MemtoReg = 1'b0;
                    id_ALUCtrl = ALU_SUB;
                    id_Branch = 1'b1;
                    id_uses_rs1 = 1'b1;
                    id_uses_rs2 = 1'b1;
                end
            default: 
                begin
                    id_ALUSrc = 1'b0;
                    id_MemtoReg = 1'b0;
                    id_ALUCtrl = ALU_ADD;
                end
        endcase
    end
    
    //Clock update
    //Multicycle require control for all stage
    always_ff@(posedge clk) begin
        if(rst)begin
            //Reset 
            if_PC <= INITIAL_PC;
            id_PC <= INITIAL_PC;
            ex_PC <= INITIAL_PC;
            immEX <= 0;
            ex_rs1 <= 0;
            ex_rs2 <= 0;
            ex_imm_branch <= 0;
            ex_rd <= 0;
            ex_ALUSrc <= 0;
            ex_ALUCtrl <= 0;
            ex_Branch <= 0;
            ex_MemRead <= 0;
            ex_MemWrite <= 0;
            ex_RegWrite <= 0;
            ex_MemtoReg <= 0;
            ex_branch_type <= 0;
            ex_jump <= 0;
            ex_jalr <= 0;
            mem_Branch <= 0;
            mem_MemRead <= 0;
            mem_MemWrite <= 0;
            mem_RegWrite <= 0;
            mem_MemtoReg <= 0;
            mem_alu_result <= 0;
            mem_zero <= 0;
            mem_branch_target <= 0;
            mem_write_data <= 0;
            mem_rd <= 0;
            mem_branch_type <= 0;
            mem_less_than <= 0;
            mem_jump <= 0;
            wb_alu_result <= 0;
            wb_RegWrite <= 0;
            wb_MemtoReg <= 0;
            wb_rd <= 0;
        end
        else if(mem_PCSrc)begin
            //branch taken implementation
            if_PC <= mem_branch_target;
            //writeback data is move
            wb_alu_result <= mem_alu_result;
            wb_RegWrite <= mem_RegWrite;
            wb_MemtoReg <= mem_MemtoReg;
            wb_rd <= mem_rd;
            //Hold execute stages
            ex_RegWrite <= 0;
            ex_MemRead <= 0;
            ex_MemWrite <= 0;
            ex_Branch <= 0;
            ex_MemtoReg <= 0;
            ex_branch_type <= 0;
            ex_jump <= 0;
            ex_jalr <= 0;
            //Hold memory stages
            mem_Branch <= 0;
            mem_MemRead <= 0;
            mem_MemWrite <= 0;
            mem_RegWrite <= 0;
            mem_MemtoReg <= 0;
            mem_branch_type <= 0;
            mem_less_than <= 0;
            mem_jump <= 0;
        end
        else if(hazard)begin
            //hazard implementation
            //control advancing from execute to memory
            mem_Branch <= ex_Branch;
            mem_MemRead <= ex_MemRead;
            mem_MemWrite <= ex_MemWrite;
            mem_RegWrite <= ex_RegWrite;
            mem_MemtoReg <= ex_MemtoReg;
            //data advancing from execute to memory
            mem_alu_result <= ex_result_to_mem;
            mem_zero <= ex_zero;
            mem_branch_target <= ex_branch_target;
            mem_write_data <= forwarded_b;
            mem_rd <= ex_rd;
            mem_branch_type <= ex_branch_type;
            mem_less_than <= ex_less_than;
            mem_jump <= ex_jump;
            //writeback results for data
            wb_alu_result <= mem_alu_result;
            wb_RegWrite <= mem_RegWrite;
            wb_MemtoReg <= mem_MemtoReg;
            wb_rd <= mem_rd;
            //Holding for execute control
            ex_RegWrite <= 0;
            ex_MemRead <= 0;
            ex_MemWrite <= 0;
            ex_Branch <= 0;
            ex_MemtoReg <= 0;
            ex_branch_type <= 0;
            ex_jump <= 0;
            ex_jalr <= 0;
        end
        else begin
            //Continue normally if nothing is detected
            if_PC <= next_PC;
            id_PC <= if_PC;
            ex_PC <= id_PC;
            if(wb_flush) begin
                ex_RegWrite <= 0;
                ex_MemRead <= 0;
                ex_MemWrite <= 0;
                ex_Branch <= 0;
                ex_MemtoReg <= 0;
                ex_branch_type <= 0;
                ex_jump <= 0;
                ex_jalr <= 0;
            end
            else begin
                ex_Branch <= id_Branch;
                ex_MemRead <= id_MemRead;
                ex_MemWrite <= id_MemWrite;
                ex_RegWrite <= id_RegWrite;
                ex_MemtoReg <= id_MemtoReg;
                ex_branch_type <= id_branch_type;
                ex_jump <= id_jump;
                ex_jalr <= id_jalr;
            end
            immEX <= selectedImmediate;
            ex_rs1 <= id_rs1;
            ex_rs2 <= id_rs2;
            ex_imm_branch <= selectedImmediate;
            ex_rd <= rd;
            ex_ALUSrc <= id_ALUSrc;
            ex_ALUCtrl <= id_ALUCtrl;
            mem_Branch <= ex_Branch;
            mem_MemRead <= ex_MemRead;
            mem_MemWrite <= ex_MemWrite;
            mem_RegWrite <= ex_RegWrite;
            mem_MemtoReg <= ex_MemtoReg;
            mem_alu_result <= ex_result_to_mem;
            mem_zero <= ex_zero;
            mem_branch_target <= ex_branch_target;
            mem_branch_type <= ex_branch_type;
            mem_write_data <= forwarded_b;
            mem_rd <= ex_rd;
            mem_less_than <= ex_less_than;
            mem_jump <= ex_jump;
            wb_alu_result <= mem_alu_result;
            wb_RegWrite <= mem_RegWrite;
            wb_MemtoReg <= mem_MemtoReg;
            wb_rd <= mem_rd;
        end
    end
    
    always_ff@(posedge clk)begin
        if(rst)wb_flush <= 0;
        else wb_flush <= mem_PCSrc;
    end
    
    //connect Mem state to memory
    assign dAddress = mem_alu_result;
    assign dWriteData = mem_write_data;
    assign MemRead = mem_MemRead;
    assign MemWrite = mem_MemWrite;
    
    //Write back MUX to load either memory data to register file or alu result
    always_comb begin
        if(wb_MemtoReg) WriteBackData = dReadData;
        else WriteBackData = wb_alu_result;
    end
    
endmodule
