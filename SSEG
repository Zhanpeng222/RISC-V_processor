`timescale 1ns / 1ps

module quad_seven_seg(input wire clk,
    input wire[3:0] val3,
    input wire[3:0] val2,
    input wire[3:0] val1,
    input wire[3:0] val0,
    output wire an3, 
    output wire an2,
    output wire an1,
    output wire an0,
    output wire ca,
    output wire cb,
    output wire cc,
    output wire cd,
    output wire ce,
    output wire cf,
    output wire cg,
    output wire dp
    );
assign dp = 1'b1; //active low means 1 = off
//clock part where the timer is set up
wire [1:0]select;
reg [17:0]count = 18'b0;
assign select = count[17:16]; //select need to be msb since it cycle the slowest
always@(posedge clk)begin
    count <= count + 1;
end

//this part control the current value which takes in the input of number
reg [3:0]current_value;
always@(*)begin
    case(select)
        2'b00: current_value = val0; 
        2'b01: current_value = val1;
        2'b10: current_value = val2;
        2'b11: current_value = val3;
        default: current_value = 4'b0000;
    endcase
end

//selecting anode, allows each value to be control seperately
assign an0 = (select == 2'b00) ? 1'b0:1'b1;
assign an1 = (select == 2'b01) ? 1'b0:1'b1;
assign an2 = (select == 2'b10) ? 1'b0:1'b1;
assign an3 = (select == 2'b11) ? 1'b0:1'b1;

//control the number based on the current value it recieve from val
reg [6:0] segment;
always@(*)begin
    case(current_value)
	    4'b0000: segment = 7'b0000001; //0
        4'b0001: segment = 7'b1001111; //1
        4'b0010: segment = 7'b0010010; //2
        4'b0011: segment = 7'b0000110; //3
        4'b0100: segment = 7'b1001100; //4
        4'b0101: segment = 7'b0100100; //5
        4'b0110: segment = 7'b0100000; //6
        4'b0111: segment = 7'b0001111; //7
        4'b1000: segment = 7'b0000000; //8
        4'b1001: segment = 7'b0001100; //9
        4'b1010: segment = 7'b0001000; //10 or A
        4'b1011: segment = 7'b1100000; //11 or B
        4'b1100: segment = 7'b0110001; //12 or C
        4'b1101: segment = 7'b1000010; //13 or D
        4'b1110: segment = 7'b0110000; //14 or E
        4'b1111: segment = 7'b0111000; //15 or F
        default: segment = 1'b1111111; //all off
    endcase
end

//assign the wire to the segment controlling which one to turn off or on
assign{ca, cb, cc, cd, ce, cf, cg} = segment;
endmodule
